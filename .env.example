# Get an API key from https://build.nvidia.com/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_API_KEY=put_your_nvidia_api_key_here
NVIDIA_CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# false hides separate reasoning traces and returns the user-facing answer.
NVIDIA_ENABLE_THINKING=false
NVIDIA_MAX_TOKENS=4096
NVIDIA_TEMPERATURE=0.2

# SQLite database file stored on this computer.
DATABASE_PATH=./data/chatbot.db
PORT=3000
SESSION_DAYS=30
