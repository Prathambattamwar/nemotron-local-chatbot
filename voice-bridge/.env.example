# Exact PWA origins (comma-separated). For a hosted PWA, add its exact HTTPS origin.
PWA_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# VoiceStudio's documented OpenAI-compatible local API base URL.
# Local loopback requests do not need an API key.
VOICESTUDIO_BASE_URL=http://127.0.0.1:3900/v1
VOICE_BRIDGE_PORT=3905
VOICESTUDIO_TTS_MODEL=omnivoice
VOICESTUDIO_TTS_VOICE=demo0001
VOICESTUDIO_TTS_FORMAT=wav
VOICESTUDIO_TTS_SPEED=1.0
# Optional; support depends on the active VoiceStudio engine. Leave blank unless your engine supports it.
VOICESTUDIO_TTS_INSTRUCT=
